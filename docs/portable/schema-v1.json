{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Vitæ portable artifact v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "context",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "profile_analysis"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_revision"
          ],
          "properties": {
            "profile_revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "strengths",
            "uncertainties"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "maxLength": 4000
            },
            "strengths": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "uncertainties": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "context",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "job_search_results"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_revision"
          ],
          "properties": {
            "profile_revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jobs"
          ],
          "properties": {
            "jobs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "company",
                  "role",
                  "url"
                ],
                "properties": {
                  "company": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "role": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 18000
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "salary": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "context",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "job_analysis"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_revision",
            "job_id",
            "job_revision",
            "job_updated_at"
          ],
          "properties": {
            "profile_revision": {
              "type": "integer",
              "minimum": 1
            },
            "job_id": {
              "type": "string",
              "maxLength": 128
            },
            "job_revision": {
              "type": "integer",
              "minimum": 0
            },
            "job_updated_at": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "strengths",
            "uncertainties",
            "sources"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "maxLength": 4000
            },
            "strengths": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "uncertainties": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "sources": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "context",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "application_draft"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_revision",
            "job_id",
            "job_revision",
            "job_updated_at"
          ],
          "properties": {
            "profile_revision": {
              "type": "integer",
              "minimum": 1
            },
            "job_id": {
              "type": "string",
              "maxLength": 128
            },
            "job_revision": {
              "type": "integer",
              "minimum": 0
            },
            "job_updated_at": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "motivation",
            "selected_facts"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "maxLength": 2000
            },
            "motivation": {
              "type": "string",
              "maxLength": 8000
            },
            "selected_facts": {
              "type": "array",
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 119
              }
            }
          }
        }
      }
    }
  ]
}
